{
	"name": "cyrus-ssh-database",
	"version": "0.2.68",
	"description": "Restricted SSH database gateway and query policy for Cyrus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyrusagents/cyrus.git",
		"directory": "packages/ssh-database"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "vitest",
		"test:run": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"cyrus-core": "workspace:*",
		"node-sql-parser": "5.4.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.3.3",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public"
	}
}
